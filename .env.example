# cista 服务端配置示例。复制为 .env（不要提交）或由 systemd EnvironmentFile 提供。
# 三把钥匙分开：MK 只在客户端；静态密钥与备份密码分开托管（design.md §2.6）。

# 监听地址（默认只绑本机，由 Caddy 反代）
CISTA_BIND=127.0.0.1:8787

# 数据目录：private.db / shared.db / blobs/{private,shared}
CISTA_DATA_DIR=./data

# 前端 origin（分享链接始终指向前端的 origin）
CISTA_FRONTEND_ORIGIN=http://127.0.0.1:5173

# 跨域部署时填后端 origin；同源留空
CISTA_CORS_ORIGIN=

# 一次性 bootstrap token：首台设备入网用；用过即从环境里删除
CISTA_BOOTSTRAP_TOKEN=

# 共享 blob 的静态加密密钥（32 字节，hex）。与 MK、备份仓库密码分开保管。
CISTA_STATIC_KEY=

# 单文件上限（字节，默认 100 MiB）与磁盘水位
CISTA_MAX_FILE_BYTES=104857600
CISTA_DISK_WATERMARK=0.90

# 日志：json（结构化，脱敏）| pretty（本地调试）
CISTA_LOG_FORMAT=json
# 限速（ADR 0007）：每设备/每链接的令牌桶；burst 缺省为 per_minute/2
CISTA_RATE_LIMIT_PER_MIN=240
CISTA_RATE_LIMIT_BURST=120
