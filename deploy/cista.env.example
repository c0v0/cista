# 安装：
#   sudo install -d -o cista -g cista /srv/cista/data /srv/cista/backup
#   sudo install -m 600 -o cista -g cista deploy/cista.env.example /etc/cista/cista.env
#   sudo install -m 600 -o cista -g cista deploy/backup.env.example /etc/cista/backup.env
# 然后填入真实值。cista.env 会被 cista.service / cista-gc.service 读取。

CISTA_BIND=127.0.0.1:8787
CISTA_DATA_DIR=/srv/cista/data
CISTA_TRUST_PROXY=1
# 仅当后端只能被私网代理访问（Docker 网桥/另一台私网 Caddy）时设为 1；
# 同机 Caddy 走回环时保持 0，避免私网客户端伪造 X-Forwarded-For。
CISTA_TRUST_PROXY_PRIVATE=0
CISTA_BOOTSTRAP_TOKEN=
CISTA_STATIC_KEY=
CISTA_LOG_FORMAT=json
CISTA_MAX_FILE_BYTES=104857600
CISTA_MIN_FREE_BYTES=536870912
CISTA_INSTANCE_QUOTA_BYTES=8589934592
CISTA_WORKSPACE_QUOTA_BYTES=2147483648
CISTA_LINK_QUOTA_BYTES=858993459
CISTA_RATE_LIMIT_PER_MIN=240
CISTA_RATE_LIMIT_BURST=120
# 跨域部署时填前端 origin；同源留空
CISTA_CORS_ORIGIN=
