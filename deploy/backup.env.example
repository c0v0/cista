# cista-backup.service 的环境文件（与 cista.env 分开：备份额外需要 restic 配置）。
# 安装：sudo install -m 600 -o cista -g cista deploy/backup.env.example /etc/cista/backup.env

# gc 的 ExecStartPre 也需要这两项
CISTA_DATA_DIR=/srv/cista/data
CISTA_STATIC_KEY=

CISTA_BACKUP_DIR=/srv/cista/backup
# 异地仓库（示例：sftp）。unit 已把 HOME 设为 /srv/cista（ProtectHome=true 隐藏 /home）：
#   sudo install -d -m 700 -o cista -g cista /srv/cista/.ssh
#   sudo install -m 600 -o cista -g cista /etc/cista/restic_key /srv/cista/.ssh/id_ed25519
#   ssh-keyscan backup.example.com | sudo tee /srv/cista/.ssh/known_hosts
# 或者改用 rest:https://…（走 443，无需 ssh 密钥）。
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/etc/cista/restic.pass
RESTIC_CACHE_DIR=/srv/cista/backup/restic-cache
